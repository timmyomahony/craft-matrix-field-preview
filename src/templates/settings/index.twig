{% from "matrix-field-preview/_includes/macros" import assetLocationInput,configWarning  %}

{% extends "matrix-field-preview/_layouts/settings" %}

{% import '_includes/forms' as forms %}

{% set fullPageForm = true %}

{% set title = "General Settings" | t("matrix-field-preview") %}

{% do view.registerTranslations('matrix-field-preview', [
    "Matrix Field Previews",
    "Preview Image Location",
    "Where do you want to store matrix field preview images?",
    "Please save this volume location for your preview images before continuing",
    "No volumes exist yet.",
]) %}

{% set crumbs = [
    {
        label: 'Settings'|t('app'),
        url: url('settings'),
    },
    {
        label: "Plugins"|t('app'),
        url: url('settings/plugins')
    },
    {
        label: "Matrix Field Previews"|t('matrix-field-preview'),
        url: url('matrix-field-preview/settings')
    }
] %}

{% block content %}
    <input type="hidden" name="pluginHandle" value="matrix-field-preview">
    <input type="hidden" name="action" value="plugins/save-plugin-settings">

    {% namespace 'settings' %}
        {#
            Adapted from:
            https://github.com/craftcms/cms/blob/develop/src/templates/settings/users/settings.html
        #}
        {% set allVolumes = craft.app.volumes.getAllVolumes() %}
        {% set volumeList = [] %}
        {% for volume in allVolumes %}
            {% set volumeList = volumeList|merge([{'value': volume.uid, 'label': volume.name}]) %}
        {% endfor %}

        {% if volumeList %}
            {{ forms.field(
                {
                    first: true,
                    label: "Preview Image Location"|t('matrix-field-preview'),
                    instructions: "Where do you want to store matrix field preview images?"|t('matrix-field-preview'),
                    warning: (not settings.previewVolumeUid) ? "Please save this volume location for your preview images before continuing"|t("matrix-field-preview") : null
                },
                assetLocationInput(volumeList, settings.previewVolumeUid, settings.previewSubpath)
            ) }}
        {% else %}
            {{ forms.field({
                first: true,
                label: "Preview Image Location"|t('matrix-field-preview'),
            }, '<p class="warning with-icon">' ~ "No volumes exist yet."|t('matrix-field-preview') ~ '</p>') }}
        {% endif %}

        <hr />

        <h2>{{ "Advanced settings" |t('matrix-field-preview') }}</h2>
        <p>{{ "Control the default behaviour for new fields and previews." |t('matrix-field-preview') }} <a target='_blank' href='https://craft-plugins.timmyomahony.com/matrix-field-preview/docs/configuration#advanced-configuration'>{{ "Learn more"|t("matrix-field-preview") }}</a></p>

        <div class="pane">
            {{ forms.lightswitchField({
                label: "Default field enabled setting"|t('matrix-field-preview'),
                instructions: "Control if new field are enabled by default"|t('matrix-field-preview'),
                name: 'defaultFieldEnabledSetting',
                id: 'defaultFieldEnabledSetting',
                on: settings.defaultFieldEnabledSetting
            }) }}

            {{ forms.lightswitchField({
                label: "Default field takeover setting"|t('matrix-field-preview'),
                instructions: "Control if new fields takeover the interface by default"|t('matrix-field-preview'),
                name: 'defaultFieldTakeoverSetting',
                id: 'defaultFieldTakeoverSetting',
                on: settings.defaultFieldTakeoverSetting
            }) }}

            {{ forms.lightswitchField({
                label: "Default preview enabled setting"|t('matrix-field-preview'),
                instructions: "Control if new previews are enabled by default"|t('matrix-field-preview'),
                name: 'defaultPreviewEnabledSetting',
                id: 'defaultPreviewEnabledSetting',
                on: settings.defaultPreviewEnabledSetting
            }) }}
        </div>
    {% endnamespace %}
{% endblock %}